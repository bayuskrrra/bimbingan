{
  "name": "sistem-guru-bk",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Manajemen Bimbingan Konseling (BK) Sekolah",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "postinstall": "prisma generate",
    "build": "prisma generate && npm run build --prefix client",
    "vercel-build": "prisma generate && npm run build --prefix client",
    "install:all": "npm install"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1"
  }
}
