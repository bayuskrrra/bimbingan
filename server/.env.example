PORT=5000
NODE_ENV=production
# Ganti dengan connection string database PostgreSQL Anda di Supabase / Neon / Render / Railway:
DATABASE_URL="postgresql://user:password@host:5432/guru_bk_db?schema=public"
JWT_SECRET="ganti-dengan-kunci-rahasia-jwt-yang-panjang-dan-acak"
JWT_EXPIRES_IN="7d"
CLIENT_URL="https://your-frontend.vercel.app"
